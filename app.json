{
  "expo": {
    "name": "Nuria",
    "slug": "nuria",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nuria",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.nuria.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.nuria.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E3550",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3550",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nuria usa tu ubicación para darte la ruta segura y el riesgo de tu calle."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Nuria usa la cámara para que reportes una calle con agua.",
          "photosPermission": "Nuria usa tus fotos para que reportes una calle con agua."
        }
      ]
    ]
  }
}
