# Copy to .env and fill in. Expo bundles EXPO_PUBLIC_* into the app, so use a demo-only key with a small balance.
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-flash
# Optional: any OpenAI-compatible server with tool calling, e.g. http://<computer>:11434/v1 for Ollama. Default: DeepSeek.
EXPO_PUBLIC_AI_BASE_URL=
